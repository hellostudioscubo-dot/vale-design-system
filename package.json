{
  "name": "vale-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Design System do Vale — App de estudos. Gerado a partir do arquivo Figma (Foundations + Components).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
